
# Dune Remaster: сервер сетевой игры (WebSocket, пересылка ходов). Отдельное имя,
# свой сертификат, свой контейнер dune-net (проект /opt/dune). Правила сайтов
# такси, кассы и Talco не затрагивает.
dune.109-235-116-121.sslip.io, dune.109-235-116-121.nip.io {
    request_body {
        max_size 64KB
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -Server
    }

    @dune path /ws /health
    handle @dune {
        reverse_proxy dune-net:8787
    }

    handle {
        respond 404
    }
}
